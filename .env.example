# Copy to .env. Secrets stay on your own machine; do not commit this file's values.
# Own account: Intervals.icu -> Settings -> Developer settings -> API key.
INTERVALS_API_KEY=replace_with_your_intervals_api_key
INTERVALS_ATHLETE_ID=0

# ServerChan Turbo: https://sct.ftqq.com -> SendKey; choose and bind a WeChat channel.
# Supported: SCT...   Not supported here: SC3 sctp...
SERVERCHAN_SENDKEY=replace_with_your_SCT_sendkey
# Optional channel ID from the ServerChan console; blank uses account defaults.
SERVERCHAN_CHANNEL=

REPORT_TIMEZONE=Europe/Amsterdam
REPORT_TIME=07:00
# summary: deterministic data summary; ai: call your configured model before delivery.
REPORT_MODE=summary

# Any OpenAI-compatible Chat Completions provider; no vendor/model is hard-coded.
# Use the provider's API root (often ending in /v1), or full /chat/completions URL.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2500
# For a trusted LAN model over HTTP only. Localhost HTTP works without this flag.
LLM_ALLOW_HTTP=false
# Leave unset for project/data; Docker sets this to /app/data.
# STATE_DIR=F:/git/MCP4Intervals/data
